rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Core primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'mahatoadityakumar170@gmail.com'
      );
    }

    // Validation helper: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'phone',
          'campus', 'dropPointType', 'dropPointDetail', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20 && data.phone.matches('^[0-9+\\-\\s]{7,20}$')))
        && (!('campus' in data) || (data.campus is string && data.campus.size() >= 2 && data.campus.size() <= 80))
        && (!('dropPointType' in data) || (data.dropPointType in ['Hostel Gate', 'PG / Flat', 'Classroom / Block']))
        && (!('dropPointDetail' in data) || (data.dropPointDetail is string && data.dropPointDetail.size() >= 2 && data.dropPointDetail.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation helper: Order
    function isValidOrder(data) {
      return data.keys().hasAll([
          'userId', 'customerName', 'customerEmail', 'phone', 'campus',
          'dropPointType', 'dropPointDetail', 'paymentMethod', 'items',
          'subtotal', 'deliveryFee', 'totalAmount', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId', 'customerName', 'customerEmail', 'phone', 'campus',
          'dropPointType', 'dropPointDetail', 'paymentMethod', 'items',
          'subtotal', 'deliveryFee', 'totalAmount', 'notes', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.userId)
        && data.customerName is string && data.customerName.size() >= 1 && data.customerName.size() <= 80
        && data.customerEmail is string && data.customerEmail.size() >= 3 && data.customerEmail.size() <= 120
        && data.phone is string && data.phone.size() <= 20 && data.phone.matches('^[0-9+\\-\\s]{7,20}$')
        && data.campus is string && data.campus.size() >= 2 && data.campus.size() <= 80
        && data.dropPointType in ['Hostel Gate', 'PG / Flat', 'Classroom / Block']
        && data.dropPointDetail is string && data.dropPointDetail.size() >= 2 && data.dropPointDetail.size() <= 120
        && data.paymentMethod in ['UPI on Delivery', 'Cash on Delivery']
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 15 && data.items[0] is map
        && data.subtotal is number && data.subtotal > 0 && data.subtotal <= 50000
        && data.deliveryFee is number && data.deliveryFee >= 0 && data.deliveryFee <= 500
        && data.totalAmount is number && data.totalAmount > 0 && data.totalAmount <= 50500
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 200))
        && data.status in ['confirmed', 'preparing', 'out_for_delivery', 'delivered', 'cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Validation helper: OrderFeedback
    function isValidFeedback(data) {
      return data.keys().hasAll([
          'userId', 'orderId', 'priceRating', 'hygieneRating',
          'deliveryRating', 'wouldOrderAgain', 'createdAt'
        ])
        && data.keys().hasOnly([
          'userId', 'orderId', 'priceRating', 'hygieneRating',
          'deliveryRating', 'wouldOrderAgain', 'comment', 'createdAt'
        ])
        && isValidId(data.userId)
        && isValidId(data.orderId)
        && data.priceRating is int && data.priceRating >= 1 && data.priceRating <= 5
        && data.hygieneRating is int && data.hygieneRating >= 1 && data.hygieneRating <= 5
        && data.deliveryRating is int && data.deliveryRating >= 1 && data.deliveryRating <= 5
        && data.wouldOrderAgain is bool
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 300))
        && data.createdAt is timestamp;
    }

    // Admins registry (read-only for self-check)
    match /admins/{adminId} {
      allow get: if isSignedIn() && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // Users collection (PII strictly isolated to owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'phone', 'campus', 'dropPointType', 'dropPointDetail', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Orders collection
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().userId == request.auth.uid
        && incoming().status == 'confirmed'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        && (
          isAdmin() ||
          (
            existing().userId == request.auth.uid
            && existing().status == 'confirmed'
            && incoming().status == 'cancelled'
          )
        );
      allow delete: if false;
    }

    // Post-order feedback collection
    match /feedback/{feedbackId} {
      allow get: if isValidId(feedbackId) && isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isVerifiedUser()
        && isValidId(feedbackId)
        && isValidFeedback(incoming())
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time
        && exists(/databases/$(database)/documents/orders/$(incoming().orderId))
        && get(/databases/$(database)/documents/orders/$(incoming().orderId)).data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
